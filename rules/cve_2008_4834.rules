# CVE-2008-4834 and CVE-2008-4835 Ruleset for SMBv1 / NetBIOS Vulnerability Evaluation
# FASTPATTERN ANCHOR RULES (Transaction candidates only: 0xA0/0xA1, 0x32/0x33, and Chained AndX)
alert tcp $EXTERNAL_NET any -> $HOME_NET [139,445] ( msg:"FASTPATTERN ANCHOR - SMBv1 NT Transact"; flow:to_server,established; content:"|00|",depth 1; content:"|FF|SMB",within 4,distance 3; pcre:"/^(\xA0|\xA1)/Rs"; sid:1; rev:2; )
alert tcp $EXTERNAL_NET any -> $HOME_NET [139,445] ( msg:"FASTPATTERN ANCHOR - SMBv1 Trans2"; flow:to_server,established; content:"|00|",depth 1; content:"|FF|SMB",within 4,distance 3; pcre:"/^(2|3)/Rs"; sid:2; rev:2; )
alert tcp $EXTERNAL_NET any -> $HOME_NET [139,445] ( msg:"FASTPATTERN ANCHOR - SMBv1 Chained Transaction"; flow:to_server,established; content:"|00|",depth 1; content:"|FF|SMB",within 4,distance 3; pcre:"/^(\x75|\x2d|\x2f|\x73|\xa2|\x2e|\x24|\x74)/Rs"; pcre:"/^(.{28}|.{30})(\xA0|\xA1|2|3)/Rs"; sid:3; rev:4; )

